{
  "name": "prettier-plugin-elm",
  "version": "1.0.0",
  "description": "Adds Elm language support to Prettier via elm-format",
  "keywords": [
    "elm",
    "elm-format",
    "gicentre",
    "prettier",
    "prettier-plugin",
    "typescript"
  ],
  "homepage": "https://github.com/gicentre/prettier-plugin-elm#readme",
  "bugs": {
    "url": "https://github.com/gicentre/prettier-plugin-elm/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gicentre/prettier-plugin-elm.git"
  },
  "license": "BSD-3-Clause",
  "author": {
    "name": "Alexander Kachkaev",
    "email": "alexander@kachkaev.ru",
    "url": "https://en.kachkaev.ru"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "changesets:publish": "changeset publish",
    "changesets:version": "changeset version && node .changeset/add-release-date.mjs && pnpm install --lockfile-only --no-frozen-lockfile",
    "clean": "rimraf cache coverage dist",
    "fix": "npm-run-all2 --continue-on-error \"fix:*\"",
    "fix:eslint": "eslint --max-warnings=0 --fix",
    "fix:markdownlint": "markdownlint --fix .",
    "fix:prettier": "prettier --write .",
    "lint": "npm-run-all2 --continue-on-error \"lint:*\"",
    "lint:eslint": "eslint --max-warnings=0",
    "lint:markdownlint": "markdownlint .",
    "lint:prettier": "prettier --check .",
    "lint:tsc": "tsc --noEmit",
    "prepack": "pnpm clean && pnpm build",
    "prepare": "node .husky/install.mjs",
    "test": "pnpm clean && pnpm build && pnpm vitest --run"
  },
  "lint-staged": {
    "**": [
      "markdownlint --fix",
      "prettier --ignore-unknown --write"
    ]
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-packagejson"
    ]
  },
  "dependencies": {
    "elm-format": "0.8.8",
    "execa": "^10.2.1",
    "object-hash": "^3.0.0",
    "serialize-error": "^13.1.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@changesets/config": "4.0.1",
    "@kachkaev/eslint-config-base": "2.0.0",
    "@kachkaev/markdownlint-config": "1.0.1",
    "@tsconfig/recommended": "1.0.14",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.6",
    "@types/object-hash": "3.0.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint-cli": "0.50.0",
    "npm-run-all2": "9.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "3.1.0",
    "prettier-v1": "npm:prettier@1.19.1",
    "prettier-v2": "npm:prettier@2.8.8",
    "rimraf": "6.1.4",
    "sleep-promise": "9.1.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
